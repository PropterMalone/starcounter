# Starcounter env vars
#
# This project uses Tier 2 direnv: real secrets live outside the repo at
#   ~/.local/share/secrets/starcounter.env (mode 600)
# and the committed `.envrc` loads them via `dotenv_if_exists`.
#
# Setup:
#   1. cp .env.example ~/.local/share/secrets/starcounter.env
#   2. chmod 600 ~/.local/share/secrets/starcounter.env
#   3. Fill in real values
#   4. cd into repo and run `direnv allow .`
#
# The systemd unit (/etc/systemd/system/starcounter-bot.service) reads
# `EnvironmentFile=/home/user/Projects/starcounter/.env`. Maintain a symlink:
#   ln -s ~/.local/share/secrets/starcounter.env ~/Projects/starcounter/.env

# Bluesky bot credentials
BSKY_HANDLE=
BSKY_PASSWORD=

# Bot database path (local SQLite for bot state)
BOT_DB_PATH=./data/bot.db
